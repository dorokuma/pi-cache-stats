# cache-stats — copy values into the host environment if needed.
# Direct-copy install is still a single file: extensions/cache-stats.ts
# This file is documentation only; the extension does not load it.

# Persist custom turn entries even on zero-cache turns (off by default)
# PI_CACHE_STATS_VERBOSE=0

# Custom TUI footer (on by default; set 0 or false to disable)
# PI_CACHE_STATS_FOOTER=1

# Read-only prefix-change snapshot at this extension's before_provider_request hook
# (on by default; set 0/false/off/no to disable)
# PI_CACHE_STATS_PREFIX_DIAGNOSTICS=1
